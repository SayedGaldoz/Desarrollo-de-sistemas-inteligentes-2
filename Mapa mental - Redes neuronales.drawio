<mxfile host="app.diagrams.net"><diagram id="rn" name="Redes neuronales"><mxGraphModel grid="0" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c" value="Redes Neuronales Artificiales" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=20;fontFamily=Arial;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="280" height="120" as="geometry"/></mxCell><mxCell id="que" value="¿Qué son?" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontFamily=Arial;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="200" height="40" as="geometry"/></mxCell><mxCell id="que0" value="Modelos de IA inspirados en las neuronas del cerebro" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="4" width="330" height="52" as="geometry"/></mxCell><mxCell id="que1" value="Neuronas organizadas en capas: entrada, ocultas y salida" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="330" height="52" as="geometry"/></mxCell><mxCell id="que2" value="Cada conexión tiene un peso; la neurona suma y aplica una función de activación (ReLU, sigmoide)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="136" width="330" height="69" as="geometry"/></mxCell><mxCell id="que3" value="Aprenden ajustando pesos con retropropagación y descenso de gradiente" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="218" width="330" height="52" as="geometry"/></mxCell><mxCell id="que4" value="Tipos: perceptrón multicapa, CNN, RNN/LSTM, Transformers" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="284" width="330" height="52" as="geometry"/></mxCell><mxCell id="ven" value="Ventajas" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontFamily=Arial;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="580" width="200" height="40" as="geometry"/></mxCell><mxCell id="ven0" value="Aprenden patrones complejos y no lineales" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="454" width="330" height="40" as="geometry"/></mxCell><mxCell id="ven1" value="Extraen características solas, sin diseñarlas a mano" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="508" width="330" height="52" as="geometry"/></mxCell><mxCell id="ven2" value="Muy precisas con datos no estructurados: imágenes, audio, texto" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="574" width="330" height="52" as="geometry"/></mxCell><mxCell id="ven3" value="Mejoran al tener más datos y más cómputo" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="330" height="40" as="geometry"/></mxCell><mxCell id="ven4" value="Una red entrenada se puede reutilizar (transfer learning)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="694" width="330" height="52" as="geometry"/></mxCell><mxCell id="des" value="Desventajas" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontFamily=Arial;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="955" width="200" height="40" as="geometry"/></mxCell><mxCell id="des0" value="Necesitan muchos datos etiquetados" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="835" width="330" height="40" as="geometry"/></mxCell><mxCell id="des1" value="Entrenamiento costoso: GPU, tiempo y energía" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="889" width="330" height="52" as="geometry"/></mxCell><mxCell id="des2" value="&quot;Caja negra&quot;: difícil explicar por qué deciden algo" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="955" width="330" height="52" as="geometry"/></mxCell><mxCell id="des3" value="Riesgo de sobreajuste si hay pocos datos" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="1021" width="330" height="40" as="geometry"/></mxCell><mxCell id="des4" value="Muchos hiperparámetros que ajustar" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="1075" width="330" height="40" as="geometry"/></mxCell><mxCell id="apl" value="Aplicaciones" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontFamily=Arial;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="230" width="200" height="40" as="geometry"/></mxCell><mxCell id="apl0" value="Visión por computadora: reconocimiento facial, autos autónomos" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="77" width="330" height="52" as="geometry"/></mxCell><mxCell id="apl1" value="Procesamiento de lenguaje: traductores, chatbots, asistentes" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="143" width="330" height="52" as="geometry"/></mxCell><mxCell id="apl2" value="Reconocimiento de voz" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="209" width="330" height="40" as="geometry"/></mxCell><mxCell id="apl3" value="Medicina: análisis de radiografías y diagnóstico por imagen" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="263" width="330" height="52" as="geometry"/></mxCell><mxCell id="apl4" value="Finanzas: detección de fraude y predicción" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="329" width="330" height="40" as="geometry"/></mxCell><mxCell id="apl5" value="Recomendaciones: Netflix, Spotify, YouTube" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="383" width="330" height="40" as="geometry"/></mxCell><mxCell id="cmp" value="Comparación con otras técnicas de IA" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontFamily=Arial;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="790" width="200" height="60" as="geometry"/></mxCell><mxCell id="cmp0" value="vs Árboles de decisión: los árboles son fáciles de interpretar y funcionan con pocos datos tabulares; las redes los superan con imágenes, audio y texto" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="636" width="360" height="86" as="geometry"/></mxCell><mxCell id="cmp1" value="vs Máquinas de Soporte Vectorial (SVM): las SVM rinden bien con pocos datos y muchas variables, pero escalan mal a millones de ejemplos; las redes escalan mejor" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="736" width="360" height="86" as="geometry"/></mxCell><mxCell id="cmp2" value="vs k-vecinos más cercanos (k-NN): k-NN no se entrena y es simple, pero es lento al predecir y sufre con muchas dimensiones; la red aprende una sola vez y predice rápido" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="835" width="360" height="86" as="geometry"/></mxCell><mxCell id="cmp3" value="vs Sistemas expertos: usan reglas escritas por humanos y son explicables; las redes aprenden las reglas solas a partir de ejemplos" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontFamily=Arial;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="935" width="360" height="69" as="geometry"/></mxCell><mxCell id="e0" style="curved=1;html=1;endArrow=none;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="c" target="que"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="curved=1;html=1;endArrow=none;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="que" target="que0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="curved=1;html=1;endArrow=none;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="que" target="que1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="curved=1;html=1;endArrow=none;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="que" target="que2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="curved=1;html=1;endArrow=none;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="que" target="que3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="curved=1;html=1;endArrow=none;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="que" target="que4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="curved=1;html=1;endArrow=none;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1" source="c" target="ven"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="curved=1;html=1;endArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="ven" target="ven0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="curved=1;html=1;endArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="ven" target="ven1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="curved=1;html=1;endArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="ven" target="ven2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="curved=1;html=1;endArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="ven" target="ven3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="curved=1;html=1;endArrow=none;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="ven" target="ven4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="curved=1;html=1;endArrow=none;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1" source="c" target="des"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="curved=1;html=1;endArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="des" target="des0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="curved=1;html=1;endArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="des" target="des1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="curved=1;html=1;endArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="des" target="des2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="curved=1;html=1;endArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="des" target="des3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="curved=1;html=1;endArrow=none;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="des" target="des4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=3;" edge="1" parent="1" source="c" target="apl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="apl" target="apl0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="apl" target="apl1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="apl" target="apl2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="apl" target="apl3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="apl" target="apl4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" style="curved=1;html=1;endArrow=none;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" parent="1" source="apl" target="apl5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" style="curved=1;html=1;endArrow=none;strokeColor=#9673a6;strokeWidth=3;" edge="1" parent="1" source="c" target="cmp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" style="curved=1;html=1;endArrow=none;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" parent="1" source="cmp" target="cmp0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" style="curved=1;html=1;endArrow=none;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" parent="1" source="cmp" target="cmp1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" style="curved=1;html=1;endArrow=none;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" parent="1" source="cmp" target="cmp2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" style="curved=1;html=1;endArrow=none;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" parent="1" source="cmp" target="cmp3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>